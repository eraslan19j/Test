<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ : sistem splash'i + core-splashscreen uyumu.
         values/themes.xml ile AYNI parent olmalı (tutarsızlık çift splash yapar). -->
    <style name="Theme.RedHawk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/redhawk_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launcher_eagle</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/redhawk_bg</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.RedHawk</item>
    </style>
    <style name="Theme.RedHawk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/redhawk_bg</item>
        <item name="android:statusBarColor">@color/redhawk_bg</item>
        <item name="android:navigationBarColor">@color/redhawk_bg</item>
    </style>
</resources>
